{
  "name": "mygamesthing", "version": "0.1.0",
  "description": "MyGamesThing",
  "author": "MyGamesThing contributors", "license": "MIT", "main": "src/main/index.js",
  "scripts": { "start": "electron .", "check": "node scripts/check.js", "test": "node --test tests/*.test.js", "smoke": "node scripts/smoke.js", "build": "npm run check && npm test && electron-builder --win --x64", "build:dir": "electron-builder --win --x64 --dir" },
  "devDependencies": { "electron": "45.1.0", "electron-builder": "26.18.0" },
  "build": {
    "appId": "io.mygamesthing.desktop", "productName": "MyGamesThing", "directories": { "output": "dist" },
    "extraResources": [{ "from": "assets/runner.exe", "to": "runner.exe" }],
    "win": {
  "target": ["nsis", "portable"],
  "icon": "assets/icon.png",
  "executableName": "MyGamesThing"
}
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "artifactName": "${productName}-${version}-${arch}-nsis.${ext}" },
    "portable": { "artifactName": "${productName}-${version}-${arch}-portable.${ext}" },
    "files": ["src/**/*", "data/**/*", "companion/**/*", "assets/icon.png", "LICENSE", "NOTICE", "README.md", "package.json"]
  }
}
